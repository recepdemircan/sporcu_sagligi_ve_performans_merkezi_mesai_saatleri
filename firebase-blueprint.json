{
  "entities": {
    "ShiftRequest": {
      "title": "Shift Request",
      "description": "A weekly shift request submitted by an employee",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "weekId": { "type": "string" },
        "shifts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
              "shiftType": { "type": "string", "enum": ["08:00-17:00", "11:00-20:00", "08:00-20:00", "off"] }
            }
          },
          "maxLength": 7
        },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "weekId", "shifts", "status", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/requests/{requestId}": {
      "schema": { "$ref": "#/entities/ShiftRequest" },
      "description": "Stores the weekly shift requests for all employees"
    }
  }
}
